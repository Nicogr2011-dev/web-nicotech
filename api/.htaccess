# Solo se sirven los endpoints. Los ficheros internos (_bootstrap.php, _mail.php,
# _stripe.php, config.php y config.example.php) los carga PHP con require, no la web.
<FilesMatch "^(_.*|config.*)\.php$|\.(sh|sql|md|bak|log|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
